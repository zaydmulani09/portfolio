---
// Signature element: projects rendered as a datasheet spec table.
interface Project {
  index: string;
  name: string;
  href: string;
  outcome: string;
  stack: string;
  proof: string;
  status: 'ACTIVE' | 'STABLE' | 'PROTOTYPE' | 'ARCHIVED';
  accent?: boolean; // accent status square — reserve for one row only
}

const projects: Project[] = [
  {
    index: '[01]',
    name: 'mnemo',
    href: 'https://github.com/zaydmulani09/mnemo',
    outcome: 'local-first AI memory layer (Mem0 alternative)',
    stack: 'rust',
    proof: '237* · HN front page',
    status: 'STABLE',
    accent: true,
  },
  {
    index: '[02]',
    name: 'mcp-gateway',
    href: 'https://github.com/zaydmulani09/mcp-gateway',
    outcome: 'self-hosted MCP reverse proxy',
    stack: 'rust/axum',
    proof: 'releases',
    status: 'ACTIVE',
  },
  {
    index: '[03]',
    name: 'agentwatch',
    href: 'https://github.com/zaydmulani09/agentwatch',
    outcome: 'local token & cost tracker for Claude Code / Codex / Gemini CLI',
    stack: 'rust',
    proof: 'Ratatui TUI',
    status: 'ACTIVE',
  },
  {
    index: '[04]',
    name: 'phaedra',
    href: 'https://github.com/zaydmulani09/phaedra',
    outcome: 'coverage-guided protocol fuzzer, LLM seed bootstrap',
    stack: 'rust',
    proof: '13* · 163 tests',
    status: 'ACTIVE',
  },
];
---

<section class="datasheet" aria-labelledby="projects-heading">
  <!-- Registration / crop-mark ticks mark the section boundary -->
  <div class="section-rule">
    <span class="crop crop-l" aria-hidden="true"></span>
    <h2 id="projects-heading" class="t-label section-label">Featured projects</h2>
    <span class="crop crop-r" aria-hidden="true"></span>
  </div>

  <table class="sheet">
    <caption class="vh">Featured projects</caption>
    <thead>
      <tr>
        <th scope="col" class="t-label">Index</th>
        <th scope="col" class="t-label">Project</th>
        <th scope="col" class="t-label">Stack</th>
        <th scope="col" class="t-label">Proof</th>
        <th scope="col" class="t-label">Status</th>
        <th scope="col" class="t-label c-arrow-h"><span class="vh">Open</span></th>
      </tr>
    </thead>
    <tbody>
      {
        projects.map((p) => (
          <tr>
            <td data-label="Index" class="c-index t-data">{p.index}</td>
            <td data-label="Project" class="c-project">
              <a
                class="proj-link"
                href={p.href}
                rel="noopener noreferrer"
              >
                <span class="proj-name">{p.name}</span>
              </a>
              <span class="proj-outcome t-body">{p.outcome}</span>
            </td>
            <td data-label="Stack" class="c-stack t-data">{p.stack}</td>
            <td data-label="Proof" class="c-proof t-data">{p.proof}</td>
            <td data-label="Status" class="c-status">
              <span
                class:list={['sq', { 'sq-accent': p.accent }]}
                aria-hidden="true"
              />
              <span class="status-label">{p.status}</span>
            </td>
            <td class="c-arrow" aria-hidden="true">
              <span class="arrow">-&gt;</span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<style>
  .datasheet {
    margin-top: var(--space-7);
  }

  /* Visually-hidden but accessible (caption + narrow-screen headers) */
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ---- Section boundary: crop-mark ticks ---- */
  .section-rule {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .section-label {
    color: var(--muted);
    flex: none;
    margin: 0;
  }
  .crop {
    height: 8px;
    flex: 1 1 auto;
    /* two corner ticks drawn as top+bottom rules meeting a vertical edge */
    border-top: 1px solid var(--rule);
  }
  .crop-l {
    border-left: 1px solid var(--ink);
  }
  .crop-r {
    border-right: 1px solid var(--ink);
  }

  /* ---- Table ---- */
  .sheet {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
  }

  thead th {
    color: var(--muted);
    text-align: left;
    font-weight: 500;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--rule);
    vertical-align: bottom;
  }
  thead th:first-child {
    padding-left: var(--space-3);
  }

  tbody td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--rule);
    vertical-align: baseline;
    background: transparent;
    transition: background-color var(--motion-fast) ease;
  }

  /* Left tick: 2px always reserved (transparent) → accent on hover, no shift */
  tbody td:first-child {
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    transition:
      background-color var(--motion-fast) ease,
      border-left-color var(--motion-fast) ease;
  }
  tbody tr:hover td {
    background: var(--surface);
  }
  tbody tr:hover td:first-child {
    border-left-color: var(--accent);
  }

  .c-index {
    color: var(--muted);
    white-space: nowrap;
    width: 1%;
  }
  .c-stack,
  .c-proof {
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---- Project cell ---- */
  .c-project {
    min-width: 22ch;
  }
  .proj-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }
  .proj-link:hover .proj-name {
    color: var(--accent);
  }
  .proj-link:hover {
    border-bottom-color: var(--accent);
  }
  /* Right-aligned open affordance: reserved space, revealed on hover/focus */
  .c-arrow {
    width: 1%;
    text-align: right;
    white-space: nowrap;
  }
  .arrow {
    display: inline-block;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.9375rem;
    opacity: 0;
    transition: opacity var(--motion-fast) ease;
  }
  tbody tr:hover .arrow,
  tbody tr:focus-within .arrow {
    opacity: 1;
  }
  .proj-outcome {
    display: block;
    margin-top: var(--space-1);
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 42ch;
  }

  /* ---- Status: filled square marker (never a dot/orb) ---- */
  .c-status {
    white-space: nowrap;
  }
  .sq {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: var(--ink);
    margin-right: var(--space-2);
    vertical-align: baseline;
  }
  .sq-accent {
    background: var(--accent);
  }
  .status-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  /* ---- Focus ring reaches project links ---- */
  .proj-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  /* ============================================================
     Responsive: restack each row into labeled blocks (no h-scroll).
     Verified down to 320px.
     ============================================================ */
  @media (max-width: 720px) {
    thead {
      /* keep real headers in the a11y tree, hide visually */
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .sheet,
    tbody,
    tbody tr,
    tbody td {
      display: block;
      width: 100%;
    }

    tbody tr {
      border-bottom: 1px solid var(--rule);
      border-left: 2px solid transparent;
      padding: var(--space-4) 0 var(--space-4) var(--space-3);
      transition:
        background-color var(--motion-fast) ease,
        border-left-color var(--motion-fast) ease;
    }
    tbody tr:hover {
      background: var(--surface);
    }
    tbody tr:hover td {
      background: transparent;
    }
    tbody tr:hover {
      border-left-color: var(--accent);
    }

    tbody td {
      border-bottom: 0;
      border-left: 0 !important;
      padding: 0;
      white-space: normal;
    }
    tbody td + td {
      margin-top: var(--space-2);
    }

    /* label:value pairs from the data-label attribute */
    tbody td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-weight: 500;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: var(--space-1);
    }
    /* project name is self-evident; drop its redundant label */
    .c-project::before {
      display: none;
    }
    .c-index {
      width: auto;
    }
    /* Hover-arrow affordance is desktop-only; hide in restacked view */
    tbody td.c-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    tbody td,
    tbody td:first-child,
    .proj-link,
    tbody tr {
      transition: none;
    }
  }
</style>
