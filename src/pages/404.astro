---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — No such record — Zayd Mulani"
  description="No record found at this address."
>
  <div slot="header" class="wordmark">
    <span class="reg-mark" aria-hidden="true"></span>
    <a class="t-label home-link" href="/">Zayd Mulani</a>
  </div>

  <p class="t-label code">Error 404</p>
  <h1 class="t-display title">No such record</h1>
  <p class="t-body measure copy">
    The address you requested is not in the datasheet. It may have moved, or it
    never existed.
  </p>
  <a class="back-link t-data" href="/">Return to index</a>

  <div slot="footer" class="site-foot">
    <span class="t-small">&copy; 2026 Zayd Mulani</span>
    <span class="foot-sep" aria-hidden="true">&middot;</span>
    <a class="foot-link t-small" href="/colophon">Colophon</a>
  </div>
</BaseLayout>

<style>
  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .reg-mark {
    width: 8px;
    height: 8px;
    background: var(--accent);
    flex: none;
  }
  .home-link {
    color: var(--muted);
    text-decoration: none;
  }
  .home-link:hover {
    color: var(--accent);
  }

  .code {
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .title {
    margin-bottom: var(--space-5);
  }
  .copy {
    color: var(--muted);
    margin-bottom: var(--space-6);
  }

  .back-link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition:
      color var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }
  .back-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .site-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
  .foot-sep {
    color: var(--rule);
  }
  .foot-link {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition:
      color var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }
  .foot-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
