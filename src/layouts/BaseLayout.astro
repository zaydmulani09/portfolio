---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** OG image path relative to site root. */
  image?: string;
  /** Emit ProfilePage JSON-LD (home only). */
  profilePage?: boolean;
}

const {
  title,
  description,
  image = '/og-image.png',
  profilePage = false,
} = Astro.props;

// `site` is set in astro.config.mjs, so absolute URLs always resolve.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = new URL(image, Astro.site).href;

const profileLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Zayd Mulani',
    url: Astro.site?.href,
    sameAs: [
      'https://github.com/zaydmulani09',
      'https://x.com/zaydmulani',
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon (registration-mark seed) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zayd Mulani" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {
      profilePage && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(profileLd)}
        />
      )
    }

    <!-- Preload the two most-used faces to cut first-paint swap -->
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="shell">
        <slot name="header" />
      </div>
    </header>

    <main id="main" class="site-main">
      <div class="shell">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <slot name="footer" />
      </div>
    </footer>
  </body>
</html>
